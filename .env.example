# Copy this file to .env and fill it in (see README › Firebase setup). .env is never committed.

# Firebase console › Project settings › General › Your apps › Web app › SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# For running the API on your computer (npm run dev, seed, set-pin, backup):
# Firebase console › Project settings › Service accounts › Generate new private key, saved as this file.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-admin-key.json

# Optional: fixed starting PINs for npm run seed (otherwise random ones are printed).
# STAFF_CASHIER_PIN=
# STAFF_MANAGER_PIN=
